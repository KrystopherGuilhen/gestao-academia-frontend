server {
    listen 80;
    server_name _;  # qualquer domínio/IP

    root /usr/share/nginx/html;
    index index.html;

    # 1) Arquivos estáticos devem existir ou retornar 404
    location /assets/ {
        try_files $uri =404;
    }

    location /favicon.ico {
        try_files $uri =404;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|svg|woff2?|ttf|eot)$ {
        try_files $uri =404;
    }

    # 2) Proxy reverso para o backend: assim o navegador do usuario so
    #    conversa com uma unica origem (este Nginx), sem CORS, e o Nginx
    #    encaminha internamente para o container do backend via a rede
    #    Docker compartilhada entre os dois repositorios/imagens.
    #    BACKEND_HOST e BACKEND_PORT sao substituidos em tempo de execucao
    #    pelo entrypoint.sh (ver docker/front/entrypoint.sh).
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 3) Rotas do Angular (History API) caem no index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Gzip
    gzip on;
    gzip_types text/plain application/xml text/css application/javascript;

    # Erros
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
